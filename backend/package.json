{
  "name": "grazyna-backend",
  "version": "5.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/workers',{recursive:true});fs.copyFileSync('src/workers/tasks.worker.cjs','dist/workers/tasks.worker.cjs')\"",
    "start": "node dist/index.js",
    "start:fastify": "USE_FASTIFY=true node dist/index.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "test:integration": "tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "fastify": "^4.29.1",
    "fastify-socket.io": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8",
    "mqtt": "^5.10.4",
    "compression": "^1.7.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^6.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9"
  },
  "engines": {
    "node": ">=20"
  }
}
