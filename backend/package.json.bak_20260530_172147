{
  "name": "grazyna-backend",
  "version": "5.0.0",
  "description": "GRAĹ»YNA 5.0 - Backend API dla systemu zarzÄ…dzania flotÄ…",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "build": "tsc",
    "start": "node --max-old-space-size=128 --expose-gc dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/database/seed.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "gc:stats": "node -e \"const v8=require('node:v8'); console.log(v8.getHeapStatistics())\"",
    "db:push": "prisma db push",
    "dev": "node --max-old-space-size=256 --expose-gc ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "db:studio": "prisma studio",
    "lint:fix": "eslint . --ext .ts --fix",
    "rebuild": "npm run clean && npm run build",
    "clean": "rimraf dist",
    "dev:full": "concurrently \"npm run dev\" \"npm run db:studio\"",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "prom-client": "^14.2.0",
    "redis": "^4.6.12",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.16",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
