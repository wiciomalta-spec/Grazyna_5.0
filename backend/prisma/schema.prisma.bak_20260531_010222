// GRAŻYNA 5.0 - Schemat bazy danych
// Prisma schema dla systemu zarządzania flotą

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]  // ✅ FIX: usunięty linux-musl (powodował crash)
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

// ════════════════════════════════════════════════════════════════
// UŻYTKOWNICY I AUTORYZACJA
// ════════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  password     String
  firstName    String?
  lastName     String?
  role         String      @default("OPERATOR")
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  missions     Mission[]
  events       Event[]
  sessions     Session[]
  
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

// ════════════════════════════════════════════════════════════════
// FLOTA POJAZDÓW
// ════════════════════════════════════════════════════════════════

model Vehicle {
  id            String         @id @default(cuid())
  name          String
  vin           String?        @unique
  type          String    @default("STANDARD")
  status        String  @default("IDLE")
  battery       Int            @default(100)
  fuelLevel     Float?
  speed         Float          @default(0)
  heading       Float?
  
  latitude      Float?
  longitude     Float?
  altitude      Float?
  
  totalDistance Float          @default(0)
  totalTime     Int            @default(0)
  lastUpdate    DateTime       @default(now())
  
  maxSpeed      Float          @default(60)
  maxRange      Float          @default(500)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  missions      Mission[]
  telemetry     Telemetry[]
  events        Event[]
  
  @@map("vehicles")
}

// ════════════════════════════════════════════════════════════════

model Mission {
  id            String         @id @default(cuid())
  name          String
  description   String?
  status        String  @default("PENDING")
  priority      String       @default("NORMAL")
  
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  
  waypoints     String?
  startLat      Float?
  startLng      Float?
  endLat        Float?
  endLng        Float?
  distance      Float?
  
  vehicleId     String?
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation(fields: [assignedToId], references: [id])
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  events        Event[]
  
  @@map("missions")
}

// ════════════════════════════════════════════════════════════════

model Telemetry {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  timestamp   DateTime @default(now())
  latitude    Float
  longitude   Float
  speed       Float
  heading     Float?
  battery     Int
  temperature Float?
  
  rawData     String?
  
  @@index([vehicleId, timestamp])
  @@map("telemetry")
}

// ════════════════════════════════════════════════════════════════

model Event {
  id          String      @id @default(cuid())
  type        String
  severity    String    @default("INFO")
  title       String
  message     String?
  metadata    String?
  
  vehicleId   String?
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  missionId   String?
  mission     Mission?    @relation(fields: [missionId], references: [id])
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  
  @@index([type, createdAt])
  @@map("events")
}


